{
  "name": "analyst-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx --conditions=react-server --env-file=.env prisma/seed.mts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed:model": "tsx --env-file=.env prisma/seed-model.mts",
    "db:backfill": "tsx --conditions=react-server --env-file=.env prisma/backfill-domain-profiles.mts",
    "db:seed:users": "tsx --conditions=react-server --env-file=.env prisma/seed-users.mts",
    "db:backfill:checksums": "tsx --conditions=react-server --env-file=.env prisma/backfill-source-checksums.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.32.0",
    "mammoth": "^1.12.1",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
