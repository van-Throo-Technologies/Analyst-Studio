# Copy to .env and fill in real values:  cp .env.example .env
#
# This file is the ONLY env file git tracks (.gitignore ignores .env*, then
# re-includes this one). It carries variable NAMES and the reasoning behind
# them — never values. If you add a variable to .env, add its name here too.

# --- Database ---------------------------------------------------------------
# Supabase Postgres. Use the SHARED (session) POOLER host, not the direct one:
# db.<project-ref>.supabase.co resolves to IPv6 only and is unreachable from
# this network (Prisma P1001 "Can't reach database server"). The pooler is
# IPv4-proxied. Copy the string from Supabase > Project Settings > Database >
# Connection string > Session pooler.
#
# The username must carry the project ref as a tenant id
# (postgres.<project-ref>), or the pooler answers ENOIDENTIFIER.
#
# Percent-encode reserved characters in the password:
#   @ -> %40   % -> %25   and likewise : / ? # [ ] and space
# An unencoded @ mis-splits the authority and Postgres reports P1000
# "credentials are not valid" even when they are.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# --- AI ---------------------------------------------------------------------
# https://console.anthropic.com > API keys
ANTHROPIC_API_KEY=""

# --- Authentication (Auth.js / NextAuth v5) ---------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""

# Sender for magic-link emails. Must be an address on a domain verified in
# Resend, or delivery fails silently from the user's point of view. Auth.js
# accepts a bare address or a "Name <address>" pair.
#
# Note that Auth.js infers a provider's key from AUTH_<ID>_KEY — AUTH_RESEND_KEY
# for this provider — so RESEND_API_KEY below is passed through explicitly in
# lib/auth.ts. Renaming it here without updating that file will break sign-in.
RESEND_API_KEY=""
EMAIL_FROM="Analyst Studio <no-reply@send.vanthroo.technology>"

# The app's own base URL. http://localhost:3000 in development; the deployed
# origin in production, or OAuth callbacks redirect to the wrong host.
NEXTAUTH_URL="http://localhost:3000"
