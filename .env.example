DATABASE_URL="file:./prisma/dev.db"
ANTHROPIC_API_KEY=""

# --- Authentication (Auth.js / NextAuth v5) ---------------------------------
# The app runs without these: with no provider configured, the development user
# switcher in the header resolves the acting user instead. Set either block to
# turn real sign-in on.

# Required once any provider below is set. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Google sign-in. Create an OAuth client in Google Cloud Console and add
# http://localhost:3000/api/auth/callback/google as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Magic-link sign-in via Resend. EMAIL_FROM must be on a domain verified in
# Resend, or delivery fails.
RESEND_API_KEY=""
EMAIL_FROM="no-reply@analyst-studio.app"
