generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Never inline the URL here — this file is tracked, and a password committed
  // to git is a password that must be rotated. The value lives in .env.
  //
  // If the password contains reserved characters, percent-encode them
  // (@ -> %40, % -> %25, and likewise : / ? # [ ] and space). An unencoded @
  // mis-splits the authority, and Postgres then answers P1000 "credentials are
  // not valid" even though they are.
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]

  @@map("user")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id             String   @id @default(cuid())
  sessionToken   String   @unique
  userId         String
  expires        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

model Project {
  id            String   @id @default(cuid())
  userId        String
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocuments   SourceDocument[]
  requirements      Requirement[]

  @@map("project")
}

model SourceDocument {
  id        String   @id @default(cuid())
  projectId String
  filename  String
  mimeType  String
  content   String   @db.Text
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("source_document")
}

model Requirement {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  description     String   @db.Text
  type            String
  priority        String
  
  actor           String?
  trigger         String?
  happyPath       String?  @db.Text
  alternateFlows  String?  @db.Text
  
  bdDAC           String?  @db.Text
  checklistAC     String?  @db.Text
  
  completionScore Int      @default(0)
  validationGates String?  @db.Text

  // Set when a person edits the requirement by hand. Re-running extraction
  // rebuilds the machine-generated set but leaves these alone, so a re-run
  // never silently discards someone's work.
  isEdited        Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("requirement")
}
