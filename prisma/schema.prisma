generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Never inline the URL here — this file is tracked, and a password committed
  // to git is a password that must be rotated. The value lives in .env.
  //
  // If the password contains reserved characters, percent-encode them
  // (@ -> %40, % -> %25, and likewise : / ? # [ ] and space). An unencoded @
  // mis-splits the authority, and Postgres then answers P1000 "credentials are
  // not valid" even though they are.
  url      = env("DATABASE_URL")
}
// RAG Database: Store 626 extracted requirements for zero-cost queries
model RuleBase {
  id                    String   @id @default(cuid())
  recordType            String   // "feature" | "business-rule" | "regulatory-constraint" | "use-case" | "acceptance-criteria"
  title                 String
  description           String
  quote                 String?  // Original source quote for grounding
  sourceDocument        String?  // Which document this came from
  tags                  String[] // e.g., ["CDD", "sanctions", "screening"]
  regulatoryFrameworks  String[] // e.g., ["FATF", "AML5", "PSD2"]
  industry              String   // e.g., "financial-services"
  parentRuleId          String?  // For linking child rules to parent
  parentRule            RuleBase? @relation("RuleHierarchy", fields: [parentRuleId], references: [id], onDelete: SetNull)
  childRules            RuleBase[] @relation("RuleHierarchy")
  confidence            Float?   // 0-1 grounding confidence
  isGrounded            Boolean  @default(false)
  isPinned              Boolean  @default(false)
  version               Int      @default(1)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([industry])
  @@index([recordType])
  @@index([tags])
  @@index([regulatoryFrameworks])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  projects      Project[]

  @@map("user")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("account")
}

model Session {
  id             String   @id @default(cuid())
  sessionToken   String   @unique
  userId         String
  expires        DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_token")
}

model Project {
  id            String   @id @default(cuid())
  userId        String
  name          String

  // What kind of business this project is for. Set once at creation and not
  // editable afterwards — extraction, quality rules and compliance checks will
  // read it, and changing it under requirements already extracted against a
  // different one would leave the two disagreeing.
  //
  // A plain string with a default rather than an enum: adding an industry later
  // should be a code change, and the default keeps existing rows valid without
  // a backfill.
  industry      String   @default("software-saas")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Share of requirement-bearing source content represented by a requirement,
  // from the coverage pass. Null until extraction has run.
  coverageScore Int?

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDocuments   SourceDocument[]
  requirements      Requirement[]
  findings          ProjectFinding[]

  @@map("project")
}

// Something the requirement set does not cover.
//
// Separate from Requirement because a finding is not a requirement — it is a
// question to put to a person. Writing them into the requirement list would be
// exactly the invention this pipeline exists to prevent.
model ProjectFinding {
  id        String   @id @default(cuid())
  projectId String

  // "coverage-gap"   — requirement-bearing content in the source that no
  //                    requirement represents.
  // "domain-gap"     — something systems of this kind normally need that
  //                    nobody in the material raised at all.
  kind      String
  title     String
  detail    String   @db.Text
  // Verbatim source quote, for coverage gaps. Null for domain gaps, which by
  // definition are not in the source.
  evidence  String?  @db.Text
  severity  String   @default("medium")
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_finding")
}

model SourceDocument {
  id        String   @id @default(cuid())
  projectId String
  filename  String
  mimeType  String
  content   String   @db.Text
  uploadedAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("source_document")
}

model Requirement {
  id              String   @id @default(cuid())
  projectId       String
  title           String
  description     String   @db.Text

  // What KIND of record this is. Distinct from `type` below, which classifies a
  // feature as Functional / Business / Non-Functional / Data / Integration —
  // that stays, because a feature is still one of those. This says whether the
  // row is a feature at all, or a rule, a constraint, a journey, or a single
  // acceptance criterion. Defaulting to "feature" backfills every existing row.
  recordType      String   @default("feature")

  // Children point at the feature they belong to. Null for top-level records.
  // onDelete: Cascade so deleting a feature takes its rules and criteria with
  // it rather than leaving them orphaned and unreachable.
  parentRequirementId String?
  parent          Requirement?  @relation("RequirementChildren", fields: [parentRequirementId], references: [id], onDelete: Cascade)
  children        Requirement[] @relation("RequirementChildren")

  type            String
  priority        String
  
  actor           String?
  trigger         String?
  happyPath       String?  @db.Text
  alternateFlows  String?  @db.Text
  
  bdDAC           String?  @db.Text
  checklistAC     String?  @db.Text
  
  completionScore Int      @default(0)
  validationGates String?  @db.Text

  // Set when a person edits the requirement by hand. Re-running extraction
  // rebuilds the machine-generated set but leaves these alone, so a re-run
  // never silently discards someone's work.
  isEdited        Boolean  @default(false)

  // --- pack fields -------------------------------------------------------
  // Which analyst pack a requirement belongs in, and the material each pack
  // needs. Stored as strings rather than enums so that adding a pack variant
  // later is a code change rather than a migration.
  scope           String   @default("in-scope")
  packVariant     String   @default("both")
  assumption      String?  @db.Text
  businessRule    String?  @db.Text
  precondition    String?  @db.Text
  dependency      String?  @db.Text
  validation      String?  @db.Text

  // --- traceability ------------------------------------------------------
  // JSON array of SourceDocument ids this requirement was drawn from. A JSON
  // column rather than a join table because it is written once per extraction
  // and only ever read whole — a relation would add a table and a migration
  // for no query we actually make.
  sourceDocumentIds String? @db.Text

  // --- grounding ---------------------------------------------------------
  // JSON array of verbatim quotes from the source that support this
  // requirement. isGrounded is set only when every quote was found in the
  // source text by literal match — it is a checked fact, not the model's
  // opinion of its own work. An ungrounded requirement is an inference, and
  // says so on its face rather than passing as evidence.
  evidence          String?  @db.Text
  isGrounded        Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("requirement")
}
